  "resolved_model_gaps": {
    "current_pregnancy_episode": {
      "fields": [
        "PniAssessmentContext.pregnancy_episode_key",
        "PniDoseRecord.pregnancy_episode_key"
      ],
      "purpose": "Distinguish vaccination in the current pregnancy from a dose administered in a previous pregnancy."
    },
    "maternal_hbsag_status": {
      "fields": [
        "PniAssessmentContext.maternal_hbsag_status"
      ],
      "allowed_states": [
        "positive",
        "negative",
        "unknown_or_unavailable"
      ],
      "unknown_equals_negative": false
    },
    "birth_weight_grams": {
      "fields": [
        "PniAssessmentContext.birth_weight_grams"
      ],
      "arbitrary_upper_bound_added": false
    },
    "bcg_scar_or_nodule_as_vaccination_evidence": {
      "fields": [
        "PniAssessmentContext.bcg_vaccination_evidence.vaccination_record_present",
        "PniAssessmentContext.bcg_vaccination_evidence.scar_present",
        "PniAssessmentContext.bcg_vaccination_evidence.palpable_nodule_present"
      ],
      "unknown_distinct_from_absent": true
    },
    "prior_disease_history": {
      "fields": [
        "PniAssessmentContext.disease_history",
        "PniDiseaseEvent.disease_key",
        "PniDiseaseEvent.evidence_source"
      ]
    },
    "disease_event_date": {
      "fields": [
        "PniDiseaseEvent.event_date"
      ],
      "unknown_date_allowed": true,
      "future_event_allowed": false
    },
    "exposure_event_date": {
      "fields": [
        "PniAssessmentContext.exposure_events",
        "PniExposureEvent.event_date"
      ],
      "future_event_allowed": false
    },
    "breastfeeding_status": {
      "fields": [
        "PniAssessmentContext.breastfeeding",
        "PniBreastfeedingContext.status",
        "PniBreastfeedingContext.youngest_breastfed_child_date_of_birth"
      ],
      "pregnancy_and_breastfeeding_merged": false
    },
    "travel_destination": {
      "fields": [
        "PniAssessmentContext.travel_contexts",
        "PniTravelContext.destination_country",
        "PniTravelContext.destination_federative_unit",
        "PniTravelContext.destination_municipality"
      ],
      "destination_implies_risk_area": false
    },
    "travel_date": {
      "fields": [
        "PniTravelContext.departure_date",
        "PniTravelContext.return_date"
      ]
    },
    "recommendation_layer:travel_or_area_risk": {
      "fields": [
        "PniRecommendationLayer.travel_or_area_risk"
      ],
      "merged_with_routine": false
    },
    "current_weight_grams": {
      "discovered_during": "BH8E6A0_BH8E6A1_BCG_preflight",
      "fields": [
        "PniAssessmentContext.current_weight_grams"
      ],
      "unit": "g",
      "source_rule": "BCG is deferred in a term or preterm newborn weighing under 2,000 g until the infant reaches 2,000 g.",
      "birth_weight_substitution_allowed": false,
      "current_weight_inference_allowed": false,
      "arbitrary_upper_bound_added": false
    }
  },

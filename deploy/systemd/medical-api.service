[Unit]
Description=Medical API Clinical Reference Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=medical-api
Group=medical-api

WorkingDirectory=/opt/medical-api/app

EnvironmentFile=/etc/medical-api/medical-api.env
Environment=MEDICAL_API_PYTHON=/opt/medical-api/app/.venv/bin/python
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

ExecStartPre=/opt/medical-api/app/.venv/bin/python /opt/medical-api/app/scripts/init_runtime_db.py
ExecStart=/opt/medical-api/app/scripts/prod_start.sh

Restart=on-failure
RestartSec=3s
TimeoutStartSec=90s
TimeoutStopSec=45s
KillSignal=SIGTERM

UMask=0027

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

ReadWritePaths=/var/lib/medical-api

[Install]
WantedBy=multi-user.target
